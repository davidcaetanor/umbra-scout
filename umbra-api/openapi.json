    "/produtos" : {
      "get" : {
        "description" : "Ordem fixa por `ordenacao`, sempre com `id` de desempate; `sort` não é aceito. Com `incluirExterno`, a primeira página traz em `externos` até 5 jogos achados no ITAD que ainda não estão no catálogo; nas demais páginas `externos` vem vazio. `categoria` vale só para hardware: com `tipo=JOGO` responde 400. `maiorDesconto` e `descontoMin` valem só com `tipo=JOGO`; `melhoresOfertas` vale para jogos e hardware e traz só o que tem desconto, pela economia em reais e pela proximidade do mínimo histórico. Com `loja`, preço e ordem são os da oferta nessa loja.",
        "operationId" : "buscarProdutos",
        "parameters" : [ {
          "in" : "query",
          "name" : "nome",
          "required" : false,
          "schema" : {
            "maxLength" : 100,
            "minLength" : 3,
            "pattern" : "^[\\p{L}\\p{N} '\\-:.&+!]+$",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "tipo",
          "required" : false,
          "schema" : {
            "enum" : [ "JOGO", "HARDWARE" ],
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "categoria",
          "required" : false,
          "schema" : {
            "enum" : [ "CPU", "GPU", "PLACA_MAE", "MEMORIA_RAM", "FONTE", "SSD", "HD", "COOLER", "KIT_HARDWARE", "PLACA_INTERFACE", "OUTROS" ],
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "ordenacao",
          "required" : false,
          "schema" : {
            "enum" : [ "nome", "menorPreco", "melhoresOfertas", "maiorDesconto" ],
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "incluirExterno",
          "required" : false,
          "schema" : {
            "type" : "boolean"
          }
        }, {
          "description" : "Preço mínimo do melhor preço atual, em centavos.",
          "in" : "query",
          "name" : "precoMin",
          "required" : false,
          "schema" : {
            "description" : "Preço mínimo do melhor preço atual, em centavos.",
            "format" : "int64",
            "minimum" : 0,
            "type" : "integer"
          }
        }, {
          "description" : "Preço máximo do melhor preço atual, em centavos.",
          "in" : "query",
          "name" : "precoMax",
          "required" : false,
          "schema" : {
            "description" : "Preço máximo do melhor preço atual, em centavos.",
            "format" : "int64",
            "minimum" : 0,
            "type" : "integer"
          }
        }, {
          "description" : "Desconto mínimo em percentual. Só com tipo=JOGO.",
          "in" : "query",
          "name" : "descontoMin",
          "required" : false,
          "schema" : {
            "description" : "Desconto mínimo em percentual. Só com tipo=JOGO.",
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "type" : "integer"
          }
        }, {
          "description" : "Loja. Com ela, preço e ordem passam a ser os dessa loja.",
          "in" : "query",
          "name" : "loja",
          "required" : false,
          "schema" : {
            "description" : "Loja. Com ela, preço e ordem passam a ser os dessa loja.",
            "enum" : [ "STEAM", "NUUVEM", "EPIC", "TERABYTE", "KABUM", "GOG", "GREEN_MAN_GAMING" ],
            "type" : "string"
          }
        }, {
          "description" : "Página, a partir de 0.",
          "in" : "query",
          "name" : "page",
          "schema" : {
            "default" : 0,
            "format" : "int32",
            "minimum" : 0,
            "type" : "integer"
          }
        }, {
          "description" : "Itens por página; acima de 20 vira 20.",
          "in" : "query",
          "name" : "size",
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "maximum" : 20,
            "minimum" : 1,
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BuscaProdutosResponse"
                }
              }
            },
            "description" : "Página do catálogo."
          },
          "400" : {
            "$ref" : "#/components/responses/ParametroInvalido"
          },
          "500" : {
            "$ref" : "#/components/responses/ErroInterno"
          }
        },
        "security" : [ ],
        "summary" : "Busca no catálogo",
        "tags" : [ "Catálogo" ]
      }
    },
