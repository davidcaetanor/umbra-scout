{
  "components" : {
    "responses" : {
      "EmConflito" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Problema"
            }
          }
        },
        "description" : "O recurso já existe."
      },
      "ErroInterno" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Problema"
            }
          }
        },
        "description" : "Erro inesperado."
      },
      "NaoAutenticado" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Problema"
            }
          }
        },
        "description" : "Token ausente, inválido ou expirado, ou credencial recusada."
      },
      "NaoEncontrado" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Problema"
            }
          }
        },
        "description" : "Recurso inexistente, de outro usuário ou de conta desativada; as três causas respondem o mesmo corpo."
      },
      "ParametroInvalido" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Problema"
            }
          }
        },
        "description" : "Parâmetro, corpo ou campo inválido; `erros` lista cada campo recusado."
      },
      "RegraViolada" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Problema"
            }
          }
        },
        "description" : "Pedido válido recusado por regra de negócio."
      },
      "ServicoIndisponivel" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Problema"
            }
          }
        },
        "description" : "Fonte externa fora ou teto de uso atingido; tente de novo depois do `Retry-After`.",
        "headers" : {
          "Retry-After" : {
            "description" : "Segundos até a próxima tentativa.",
            "schema" : {
              "type" : "integer"
            }
          }
        }
      }
    },
    "schemas" : {
      "AlterarMonitoramentoRequest" : {
        "properties" : {
          "ativo" : {
            "type" : "boolean"
          },
          "precoAlvoCentavos" : {
            "format" : "int64",
            "maximum" : 100000000,
            "minimum" : 1,
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "BuscaProdutosResponse" : {
        "properties" : {
          "conteudo" : {
            "items" : {
              "$ref" : "#/components/schemas/ProdutoResumoResponse"
            },
            "type" : "array"
          },
          "externos" : {
            "items" : {
              "$ref" : "#/components/schemas/ProdutoExternoResponse"
            },
            "type" : "array"
          },
          "pagina" : {
            "format" : "int32",
            "type" : "integer"
          },
          "tamanho" : {
            "format" : "int32",
            "type" : "integer"
          },
          "totalElementos" : {
            "format" : "int64",
            "type" : "integer"
          },
          "totalPaginas" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "conteudo", "externos", "pagina", "tamanho", "totalElementos", "totalPaginas" ],
        "type" : "object"
      },
      "CadastroRequest" : {
        "properties" : {
          "cep" : {
            "pattern" : "[0-9]{8}",
            "type" : "string"
          },
          "email" : {
            "format" : "email",
            "maxLength" : 320,
            "minLength" : 0,
            "type" : "string"
          },
          "nomeExibicao" : {
            "maxLength" : 60,
            "minLength" : 0,
            "type" : "string"
          },
          "senha" : {
            "maxLength" : 2147483647,
            "minLength" : 8,
            "type" : "string"
          }
        },
        "required" : [ "email", "nomeExibicao", "senha" ],
        "type" : "object"
      },
      "CriarMonitoramentoRequest" : {
        "properties" : {
          "gid" : {
            "format" : "uuid",
            "type" : "string"
          },
          "precoAlvoCentavos" : {
            "format" : "int64",
            "maximum" : 100000000,
            "minimum" : 1,
            "type" : "integer"
          },
          "produtoId" : {
            "exclusiveMinimum" : 0,
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "precoAlvoCentavos" ],
        "type" : "object"
      },
      "DestaquesResponse" : {
        "properties" : {
          "conteudo" : {
            "items" : {
              "$ref" : "#/components/schemas/ProdutoResumoResponse"
            },
            "type" : "array"
          }
        },
        "required" : [ "conteudo" ],
        "type" : "object"
      },
      "HistoricoResponse" : {
        "properties" : {
          "consultadoEm" : {
            "format" : "date-time",
            "type" : "string"
          },
          "faixas" : {
            "items" : {
              "format" : "int64",
              "type" : "integer"
            },
            "type" : "array"
          },
          "melhorPreco" : {
            "items" : {
              "$ref" : "#/components/schemas/PontoHistoricoResponse"
            },
            "type" : "array"
          },
          "minimo" : {
            "anyOf" : [ {
              "$ref" : "#/components/schemas/MinimoHistoricoResponse"
            }, {
              "type" : "null"
            } ]
          },
          "observadoDesde" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "periodo" : {
            "type" : "string"
          },
          "porLoja" : {
            "items" : {
              "$ref" : "#/components/schemas/SerieLojaResponse"
            },
            "type" : "array"
          },
          "variacao" : {
            "$ref" : "#/components/schemas/VariacaoResponse"
          }
        },
        "required" : [ "consultadoEm", "faixas", "melhorPreco", "minimo", "observadoDesde", "periodo", "porLoja", "variacao" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "email" : {
            "maxLength" : 320,
            "minLength" : 0,
            "type" : "string"
          },
          "senha" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "senha" ],
        "type" : "object"
      },
      "MinimoHistoricoResponse" : {
        "properties" : {
          "em" : {
            "format" : "date-time",
            "type" : "string"
          },
          "gratuito" : {
            "type" : "boolean"
          },
          "loja" : {
            "type" : "string"
          },
          "valorCentavos" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "em", "gratuito", "loja", "valorCentavos" ],
        "type" : "object"
      },
      "MonitoramentoResponse" : {
        "properties" : {
          "alvoAtingido" : {
            "type" : "boolean"
          },
          "aparentementeDescontinuado" : {
            "type" : "boolean"
          },
          "ativo" : {
            "type" : "boolean"
          },
          "criadoEm" : {
            "format" : "date-time",
            "type" : "string"
          },
          "distanciaDoAlvoCentavos" : {
            "format" : "int64",
            "type" : [ "integer", "null" ]
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "imagemUrl" : {
            "type" : [ "string", "null" ]
          },
          "melhorPreco" : {
            "anyOf" : [ {
              "$ref" : "#/components/schemas/OfertaResponse"
            }, {
              "type" : "null"
            } ]
          },
          "nome" : {
            "type" : "string"
          },
          "precoAlvoCentavos" : {
            "format" : "int64",
            "type" : "integer"
          },
          "produtoId" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "alvoAtingido", "aparentementeDescontinuado", "ativo", "criadoEm", "distanciaDoAlvoCentavos", "id", "imagemUrl", "melhorPreco", "nome", "precoAlvoCentavos", "produtoId" ],
        "type" : "object"
      },
      "MonitoramentosResponse" : {
        "properties" : {
          "conteudo" : {
            "items" : {
              "$ref" : "#/components/schemas/MonitoramentoResponse"
            },
            "type" : "array"
          },
          "pagina" : {
            "format" : "int32",
            "type" : "integer"
          },
          "tamanho" : {
            "format" : "int32",
            "type" : "integer"
          },
          "totalElementos" : {
            "format" : "int64",
            "type" : "integer"
          },
          "totalPaginas" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "conteudo", "pagina", "tamanho", "totalElementos", "totalPaginas" ],
        "type" : "object"
      },
      "OfertaResponse" : {
        "properties" : {
          "coletadoEm" : {
            "format" : "date-time",
            "type" : "string"
          },
          "descontoPct" : {
            "format" : "int32",
            "type" : [ "integer", "null" ]
          },
          "expiraEm" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "gratuito" : {
            "type" : "boolean"
          },
          "loja" : {
            "type" : "string"
          },
          "situacao" : {
            "enum" : [ "vigente", "promocao-no-prazo", "verificacao-atrasada", "promocao-vencida-sem-coleta" ],
            "type" : "string"
          },
          "url" : {
            "type" : "string"
          },
          "valorCentavos" : {
            "format" : "int64",
            "type" : "integer"
          },
          "valorOriginalCentavos" : {
            "format" : "int64",
            "type" : [ "integer", "null" ]
          },
          "verificadoEm" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "required" : [ "coletadoEm", "descontoPct", "expiraEm", "gratuito", "loja", "situacao", "url", "valorCentavos", "valorOriginalCentavos", "verificadoEm" ],
        "type" : "object"
      },
      "PontoHistoricoResponse" : {
        "properties" : {
          "instante" : {
            "format" : "date-time",
            "type" : "string"
          },
          "valorCentavos" : {
            "format" : "int64",
            "type" : [ "integer", "null" ]
          }
        },
        "required" : [ "instante", "valorCentavos" ],
        "type" : "object"
      },
      "Problema" : {
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "erros" : {
            "description" : "Presente só no 400.",
            "items" : {
              "properties" : {
                "campo" : {
                  "type" : "string"
                },
                "mensagem" : {
                  "type" : "string"
                }
              },
              "required" : [ "campo", "mensagem" ],
              "type" : "object"
            },
            "type" : "array"
          },
          "instance" : {
            "format" : "uri-reference",
            "type" : "string"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "required" : [ "detail", "instance", "status", "title", "type" ],
        "type" : "object"
      },
      "ProdutoExternoResponse" : {
        "properties" : {
          "gid" : {
            "type" : "string"
          },
          "imagemUrl" : {
            "type" : [ "string", "null" ]
          },
          "melhorPreco" : {
            "$ref" : "#/components/schemas/OfertaResponse"
          },
          "nome" : {
            "type" : "string"
          }
        },
        "required" : [ "gid", "imagemUrl", "melhorPreco", "nome" ],
        "type" : "object"
      },
      "ProdutoResponse" : {
        "properties" : {
          "categoria" : {
            "type" : [ "string", "null" ]
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "imagemUrl" : {
            "type" : [ "string", "null" ]
          },
          "melhorPreco" : {
            "anyOf" : [ {
              "$ref" : "#/components/schemas/OfertaResponse"
            }, {
              "type" : "null"
            } ]
          },
          "nome" : {
            "type" : "string"
          },
          "ofertas" : {
            "items" : {
              "$ref" : "#/components/schemas/OfertaResponse"
            },
            "type" : "array"
          },
          "tipo" : {
            "enum" : [ "JOGO", "HARDWARE" ],
            "type" : "string"
          }
        },
        "required" : [ "categoria", "id", "imagemUrl", "melhorPreco", "nome", "ofertas", "tipo" ],
        "type" : "object"
      },
      "ProdutoResumoResponse" : {
        "properties" : {
          "categoria" : {
            "type" : [ "string", "null" ]
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "imagemUrl" : {
            "type" : [ "string", "null" ]
          },
          "melhorPreco" : {
            "anyOf" : [ {
              "$ref" : "#/components/schemas/OfertaResponse"
            }, {
              "type" : "null"
            } ]
          },
          "nome" : {
            "type" : "string"
          },
          "tipo" : {
            "enum" : [ "JOGO", "HARDWARE" ],
            "type" : "string"
          }
        },
        "required" : [ "categoria", "id", "imagemUrl", "melhorPreco", "nome", "tipo" ],
        "type" : "object"
      },
      "SerieLojaResponse" : {
        "properties" : {
          "loja" : {
            "type" : "string"
          },
          "pontos" : {
            "items" : {
              "$ref" : "#/components/schemas/PontoHistoricoResponse"
            },
            "type" : "array"
          }
        },
        "required" : [ "loja", "pontos" ],
        "type" : "object"
      },
      "TokenResponse" : {
        "properties" : {
          "expiraEm" : {
            "format" : "date-time",
            "type" : "string"
          },
          "tipo" : {
            "type" : "string"
          },
          "token" : {
            "type" : "string"
          }
        },
        "required" : [ "expiraEm", "tipo", "token" ],
        "type" : "object"
      },
      "TrocaDeCodigoRequest" : {
        "properties" : {
          "codigo" : {
            "maxLength" : 64,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "codigo" ],
        "type" : "object"
      },
      "UsuarioResponse" : {
        "properties" : {
          "cep" : {
            "type" : [ "string", "null" ]
          },
          "cidade" : {
            "type" : [ "string", "null" ]
          },
          "criadoEm" : {
            "format" : "date-time",
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "nomeExibicao" : {
            "type" : "string"
          },
          "uf" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "cep", "cidade", "criadoEm", "email", "id", "nomeExibicao", "uf" ],
        "type" : "object"
      },
      "VariacaoResponse" : {
        "properties" : {
          "diferencaCentavos" : {
            "format" : "int64",
            "type" : [ "integer", "null" ]
          },
          "percentualAcimaDoMinimo" : {
            "type" : [ "number", "null" ]
          },
          "precoAtualCentavos" : {
            "format" : "int64",
            "type" : [ "integer", "null" ]
          }
        },
        "required" : [ "diferencaCentavos", "percentualAcimaDoMinimo", "precoAtualCentavos" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "description" : "Catálogo de preços de jogos e hardware e monitoramento de preço-alvo. Erros seguem a RFC 9457 em application/problem+json.",
    "title" : "Umbra API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/auth/cadastro" : {
      "post" : {
        "description" : "CEP opcional, aceito com ou sem máscara; a cidade vem do ViaCEP quando disponível.",
        "operationId" : "cadastrar",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CadastroRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UsuarioResponse"
                }
              }
            },
            "description" : "Conta criada."
          },
          "400" : {
            "$ref" : "#/components/responses/ParametroInvalido"
          },
          "409" : {
            "$ref" : "#/components/responses/EmConflito"
          },
          "500" : {
            "$ref" : "#/components/responses/ErroInterno"
          }
        },
        "security" : [ ],
        "summary" : "Cria conta com email e senha",
        "tags" : [ "Autenticação" ]
      }
    },
    "/auth/login" : {
      "post" : {
        "operationId" : "entrar",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "Token de acesso."
          },
          "400" : {
            "$ref" : "#/components/responses/ParametroInvalido"
          },
          "401" : {
            "$ref" : "#/components/responses/NaoAutenticado"
          },
          "500" : {
            "$ref" : "#/components/responses/ErroInterno"
          }
        },
        "security" : [ ],
        "summary" : "Login por email e senha",
        "tags" : [ "Autenticação" ]
      }
    },
    "/auth/oauth2/token" : {
      "post" : {
        "description" : "O código chega ao frontend no retorno de `/login/oauth2/code/{provedor}`, vale uma vez e expira em pouco tempo.",
        "operationId" : "trocarCodigoDeLoginExterno",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TrocaDeCodigoRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "Token de acesso."
          },
          "400" : {
            "$ref" : "#/components/responses/ParametroInvalido"
          },
          "401" : {
            "$ref" : "#/components/responses/NaoAutenticado"
          },
          "500" : {
            "$ref" : "#/components/responses/ErroInterno"
          }
        },
        "security" : [ ],
        "summary" : "Troca o código do login externo por token",
        "tags" : [ "Autenticação" ]
      }
    },
    "/login/oauth2/code/{provedor}" : {
      "get" : {
        "description" : "Chamada pelo provedor, nunca pelo frontend. Redireciona ao endereço de retorno do frontend com `codigo`, a ser trocado em `POST /auth/oauth2/token`, ou com `erro`, um dos códigos: email_nao_verificado, conta_inativa, conta_vinculada_a_outra_identidade, falha_no_provedor, entrada_cancelada.",
        "operationId" : "receberRetornoDoProvedor",
        "parameters" : [ {
          "in" : "path",
          "name" : "provedor",
          "required" : true,
          "schema" : {
            "enum" : [ "discord", "google" ],
            "type" : "string"
          }
        } ],
        "responses" : {
          "302" : {
            "description" : "Redireciona ao frontend com `codigo` ou `erro`."
          }
        },
        "security" : [ ],
        "summary" : "Retorno do provedor externo",
        "tags" : [ "Autenticação" ]
      }
    },
    "/monitoramentos" : {
      "get" : {
        "description" : "Ordem fixa, do mais recente ao mais antigo; `sort` não é aceito. Com `produtoId`, devolve só o monitoramento daquele produto, se existir.",
        "operationId" : "listarMonitoramentos",
        "parameters" : [ {
          "description" : "Filtra pelo produto do catálogo.",
          "in" : "query",
          "name" : "produtoId",
          "required" : false,
          "schema" : {
            "description" : "Filtra pelo produto do catálogo.",
            "exclusiveMinimum" : 0,
            "format" : "int64",
            "type" : "integer"
          }
        }, {
          "description" : "Página, a partir de 0.",
          "in" : "query",
          "name" : "page",
          "schema" : {
            "default" : 0,
            "format" : "int32",
            "minimum" : 0,
            "type" : "integer"
          }
        }, {
          "description" : "Itens por página; acima de 20 vira 20.",
          "in" : "query",
          "name" : "size",
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "maximum" : 20,
            "minimum" : 1,
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MonitoramentosResponse"
                }
              }
            },
            "description" : "Página de monitoramentos."
          },
          "400" : {
            "$ref" : "#/components/responses/ParametroInvalido"
          },
          "401" : {
            "$ref" : "#/components/responses/NaoAutenticado"
