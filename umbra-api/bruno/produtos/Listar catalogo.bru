meta {
  name: Listar catalogo
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/produtos
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200 && res.body.conteudo.length > 0) {
    bru.setVar("produtoId", res.body.conteudo[0].id);
  }
}

assert {
  res.status: eq 200
  res.body.conteudo: isArray
  res.body.pagina: eq 0
  res.body.tamanho: lte 20
}
