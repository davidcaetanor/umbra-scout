meta {
  name: Monitorar produto do catalogo
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/monitoramentos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "produtoId": {{produtoId}},
    "precoAlvoCentavos": 5000
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("monitoramentoId", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.produtoId: eq {{produtoId}}
  res.body.precoAlvoCentavos: eq 5000
  res.body.ativo: eq true
  res.body.aparentementeDescontinuado: isBoolean
}

tests {
  test("aponta o recurso criado no Location", function () {
    expect(res.getHeader("location")).to.match(/\/monitoramentos\/\d+$/);
  });
}
