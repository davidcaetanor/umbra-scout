{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$UMBRA_WEB_API_URL}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	@callback path /login/callback
	header @callback Referrer-Policy no-referrer

	@foraDoCallback not path /login/callback
	header @foraDoCallback Referrer-Policy strict-origin-when-cross-origin

	map {http.request.orig_uri.path} {origem_da_imagem} {politica_de_cache} {
		~^/imagens/(?:[0-9]+/)?itad/ https://assets.isthereanydeal.com "public, max-age=31536000, immutable"
		~^/imagens/(?:[0-9]+/)?kabum/ https://images.kabum.com.br "public, max-age=2592000"
		~^/(?:mascote|marca|fontes)/v1/ - "public, max-age=31536000, immutable"
		~-[A-Za-z0-9_-]{8}\.(?:js|css|woff2?)$ - "public, max-age=31536000, immutable"
		default - "no-store"
	}

	@foraDasImagens not path /imagens/*
	header @foraDasImagens Cache-Control {politica_de_cache}

	handle /config.json {
		root * /run/umbra
		file_server
	}

	@imagemDeLoja {
		method GET
		path_regexp imagem ^/imagens/(?:(240|480|600)/)?(?:itad|kabum)/(.+)$
	}

	map {re.imagem.1} {preset_da_capa} {
		240 capa-240
		480 capa-480
		600 capa-600
		default capa
	}

	handle @imagemDeLoja {
		rewrite * /_/{preset_da_capa}/plain/{origem_da_imagem}/{re.imagem.2}?
		reverse_proxy {$UMBRA_WEB_IMAGENS_URL:http://imagens:8080} {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -Referer
			header_up -Cookie
			header_up -Authorization
			header_down -Set-Cookie
			header_down Cache-Control "^max-age=31536000, public$" {politica_de_cache}

			@falhou status 4xx 5xx
			handle_response @falhou {
				header Cache-Control "no-store"
				copy_response
			}
		}
	}

	handle /imagens/* {
		respond 404
	}

	handle /saude {
		respond "ok" 200
	}

	handle {
		route {
			try_files {path} /index.html
			@paginaDoApp path / /index.html
			root @paginaDoApp /run/umbra
			file_server
		}
	}
}
