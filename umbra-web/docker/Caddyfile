{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$UMBRA_WEB_API_URL}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	@callback path /login/callback
	header @callback Referrer-Policy no-referrer

	@foraDoCallback not path /login/callback
	header @foraDoCallback Referrer-Policy strict-origin-when-cross-origin

	@comHash path_regexp \-[A-Z0-9]{8}\.(js|css|woff2?)$
	header @comHash Cache-Control "public, max-age=31536000, immutable"

	@semHash {
		not path_regexp \-[A-Z0-9]{8}\.(js|css|woff2?)$
		not path /imagens/*
	}
	header @semHash Cache-Control "no-store"

	handle /config.json {
		root * /run/umbra
		file_server
	}

	map {path} {origem_da_imagem} {
		~^/imagens/itad/ https://assets.isthereanydeal.com
		~^/imagens/kabum/ https://images.kabum.com.br
	}

	@imagemDeLoja {
		method GET
		path_regexp imagem ^/imagens/(?:itad|kabum)/(.+)$
	}
	handle @imagemDeLoja {
		rewrite * /_/capa/plain/{origem_da_imagem}/{re.imagem.1}?
		reverse_proxy {$UMBRA_WEB_IMAGENS_URL:http://imagens:8080} {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -Referer
			header_up -Cookie
			header_up -Authorization
			header_down -Set-Cookie

			@falhou status 4xx 5xx
			handle_response @falhou {
				header Cache-Control "no-store"
				copy_response
			}
		}
	}

	handle /imagens/* {
		respond 404
	}

	handle /saude {
		respond "ok" 200
	}

	handle {
		route {
			try_files {path} /index.html
			@paginaDoApp path / /index.html
			root @paginaDoApp /run/umbra
			file_server
		}
	}
}
